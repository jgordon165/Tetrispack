# Build output
/build/
/build-*/
out/
.vs/
*.user

# Original game files are NEVER committed. Point the engine at your own copy
# with --data <path>. These patterns are a safety net in case files get
# copied into the tree by accident.
data/
gamedata/
*.EXE
*.exe
*.HLP
*.hlp
ABOUTTET.DLL
[Aa]bouttet.dll
*.HST
*.hst
*.BMP
*.bmp
*.ini
*.INI
*.ISO
*.iso
*.img
*.IMG

# Reverse-engineering output contains decompiled original code and extracted
# resources; keep it local.
re/output/
re/ghidra_project/

# Python
__pycache__/
*.pyc

# CI / packaging output
stage/
dist/
.deps/

# Console builds: devkits fetched by consoles/*/setup-*.sh, build output
/.sgdk/
/.pvsneslib/
/build-genesis/
/build-snes/
/consoles/xbox360/bin/
/consoles/xbox360/obj/
/stage/
